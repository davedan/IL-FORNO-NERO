---
import Base from '../layouts/Base.astro'
import { fallbackMenu } from '../lib/menu'
---
<Base title="Il Forno Nero | Pizzería napoletana en Madrid">
  <header class="shell nav"><a class="brand" href="/">Il Forno Nero</a><nav class="navlinks"><a href="#carta">Menú</a><a href="#nosotros">Nosotros</a><a href="#galeria">Galería</a><a href="#promos">Promos</a><a href="#resenas">Reseñas</a><a href="#faq">FAQ</a><a href="#contacto">Contacto</a><a href="/delivery">Delivery</a><a href="/noticias">Noticias</a></nav><a class="nav-book" href="#reservas">Reservar</a></header>
  <main>
    <section class="hero"><div><p class="eyebrow">Pizzería napoletana · Chueca, Madrid</p><h1>El fuego que<br /><em>nunca se apaga.</em></h1><p class="lead">Masa madre, horno de leña y la tradición de Nápoles. Reserva tu mesa o pide para recoger desde la web.</p><a class="button" href="#carta">Ver carta</a><a class="button alt" href="#reservas">Reservar mesa</a></div></section>
    <section id="carta" class="menu"><div class="shell"><p class="eyebrow">La carta</p><h2>Producto italiano, fuego vivo.</h2><p class="lead">La disponibilidad se actualiza desde el restaurante.</p><div class="grid" data-menu-catalog>{fallbackMenu.map((category) => <div class="category"><h3>{category.name}</h3>{category.items.map((item) => <article class="item"><div class="itemhead"><span>{item.name}{item.vegetarian && ' · V'}</span><span>{item.price.toFixed(2)} €</span></div><p>{item.description}</p>{item.available ? <><label class="customize">Personaliza<input data-customizations={item.slug} maxlength="180" placeholder="Sin cebolla, punto de horneado…" /></label><button class="button add-item" type="button" data-slug={item.slug} data-name={item.name} data-price={item.price}>Añadir al pedido</button></> : <span class="note">No disponible</span>}</article>)}</div>)}</div></div></section>
    <section id="nosotros" class="story"><div class="shell split"><div><p class="eyebrow">Nuestra historia</p><h2>La familia Marchetti.</h2><p class="lead">En 1978, Salvatore Marchetti encendió su primer horno en el barrio de la Sanità, en Nápoles. Cuarenta años después, sus hijos Gennaro y Lucia cruzaron el Mediterráneo con la misma masa madre viva en una maleta.</p><p class="lead">Il Forno Nero abrió en Calle de la Reina en 2019: un comedor oscuro y cálido, mesas de madera, velas y un horno de leña que llega a 480°C.</p><dl class="stats"><div><dt>1978</dt><dd>Primer horno en Nápoles</dd></div><div><dt>72h</dt><dd>De fermentación</dd></div><div><dt>480°C</dt><dd>Horno de leña</dd></div><div><dt>2019</dt><dd>Llegamos a Madrid</dd></div></dl></div><img src="https://images.hostinger.com/569fd2f0-8dad-46a2-915a-aa536605226b.png" alt="Interior de Il Forno Nero" loading="lazy" /></div></section>
    <section id="galeria" class="gallery menu"><div class="shell"><p class="eyebrow">Galería</p><h2>Fuego, masa y mesa.</h2><div class="grid"><img src="https://images.hostinger.com/161cae1b-fb49-46dc-9743-508f76b01f69.png" alt="Pizza Margherita" loading="lazy" /><img src="https://images.hostinger.com/7531b623-2fe3-42e0-a495-1d596c21232b.png" alt="Pizza Nero" loading="lazy" /><img src="https://images.hostinger.com/5267ed01-5467-474b-b569-159afc6742c6.png" alt="Pizza Diavola" loading="lazy" /><img src="https://images.hostinger.com/1c3e9407-d0ba-4059-a58c-4bb92661df5b.png" alt="Amasado a mano" loading="lazy" /><img src="https://images.hostinger.com/b2a4aa15-82c8-42b2-ae66-6d9a90a61abf.png" alt="Chianti y pizza" loading="lazy" /><img src="https://images.hostinger.com/569fd2f0-8dad-46a2-915a-aa536605226b.png" alt="El comedor" loading="lazy" /></div></div></section>
    <section id="promos" class="promos"><div class="shell"><p class="eyebrow">Promociones</p><h2>Motivos para volver.</h2><div class="offer-list"><article><span>01</span><h3>Martes de Focaccia</h3><p>2x1 en todas nuestras focaccias, todos los martes de 20:00 a 00:00.</p></article><article><span>02</span><h3>Menú del mediodía</h3><p>Pizza clásica + bebida + postre por 16,50 € de martes a viernes al mediodía.</p></article><article><span>03</span><h3>Recogida en local</h3><p>10 % de descuento en todos los pedidos que recojas en Calle de la Reina, 14.</p></article></div></div></section>
    <section id="resenas" class="reviews menu"><div class="shell"><p class="eyebrow">Reseñas</p><h2>Lo que dicen en la mesa.</h2><div class="grid"><blockquote>“La Nero es la mejor pizza que he comido fuera de Italia. El cornicione está a otro nivel.”<footer>Marta Sanz · Vecina de Chueca</footer></blockquote><blockquote>“Sono napoletano e qui mi sento a casa: impasto leggero, cottura perfetta.”<footer>Antonio Esposito · Cliente habitual</footer></blockquote><blockquote>“Nos explicaron todos los alérgenos con muchísima paciencia.”<footer>Javier Ortega · Cena familiar</footer></blockquote></div></div></section>
    <section id="reservas"><div class="shell split"><div><p class="eyebrow">Reservas</p><h2>Reserva tu mesa.</h2><p class="lead">Tu solicitud se registra para que el equipo la confirme personalmente. Si necesitas cambiarla o cancelarla, llámanos.</p></div><form class="panel" data-operation="reservation"><label>Nombre<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Teléfono<input name="telephone" autocomplete="tel" required /></label><label>Fecha<input type="date" name="date" required /></label><label>Hora<select name="time" data-reservation-slots required><option value="">Selecciona una hora</option></select></label><label>Personas<input type="number" name="people" min="1" max="20" required /></label><label>Observaciones<textarea name="notes" maxlength="1000"></textarea></label><button class="button" type="submit">Enviar solicitud</button><p class="note" data-message aria-live="polite"></p></form></div></section>
    <section id="recogida" class="menu"><div class="shell split"><div><p class="eyebrow">Click & collect</p><h2>Recógelo en 30 o 45 minutos.</h2><p class="lead">Revisa tu selección y elige cuándo vienes. El pago de esta fase es una simulación: no se realiza ningún cobro real.</p><div class="cart" aria-live="polite"><p class="note">Tu pedido</p><ul data-cart><li>Aún no has añadido productos.</li></ul><p class="cart-total">Total: <strong data-total>0,00 €</strong></p></div></div><form class="panel" data-operation="order"><label>Nombre<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Teléfono<input name="telephone" autocomplete="tel" required /></label><label>Recogida<select name="pickupMinutes"><option value="30">En 30 minutos</option><option value="45">En 45 minutos</option></select></label><button class="button" type="submit">Confirmar pedido simulado</button><p class="note" data-message aria-live="polite"></p></form></div></section>
    <section id="faq" class="faq"><div class="shell"><p class="eyebrow">Preguntas frecuentes</p><h2>Todo lo que sueles preguntarnos.</h2><details open><summary>¿Tenéis opción sin gluten?</summary><p>Sí. Todas nuestras pizzas pueden prepararse con masa sin gluten por 2,00 € adicionales. Trabajamos con superficie y utensilios separados, aunque la cocina no está libre de trazas.</p></details><details><summary>¿Dónde consulto los alérgenos?</summary><p>Disponemos de la carta completa de alérgenos en el local. Avísanos al reservar y adaptamos lo que haga falta.</p></details><details><summary>¿Hace falta reservar?</summary><p>Lo recomendamos, especialmente de jueves a domingo.</p></details><details><summary>¿Hay parking cerca?</summary><p>Los aparcamientos de Plaza del Rey y Calle Barbieri están a menos de cinco minutos andando.</p></details><details><summary>¿Se puede ir con niños o grupos?</summary><p>Por supuesto. Admitimos grupos de hasta 14 personas reservando con 48 horas de antelación.</p></details></div></section>
    <section id="contacto" class="contact menu"><div class="shell split"><div><p class="eyebrow">Dónde estamos</p><h2>Ubicación y contacto.</h2><dl class="contact-data"><div><dt>Dirección</dt><dd>Calle de la Reina, 14 · 28004 Madrid (Chueca)</dd></div><div><dt>Horario</dt><dd>Martes a domingo · 13:00–16:00 y 20:00–00:00<br />Lunes cerrado</dd></div><div><dt>Teléfono</dt><dd><a href="tel:+34910456782">+34 910 456 782</a></dd></div><div><dt>Email</dt><dd><a href="mailto:hola@ilfornonero.es">hola@ilfornonero.es</a></dd></div></dl></div><div><img src="https://images.hostinger.com/bc5f8b0a-51e7-4b57-ad89-f850a76e37d6.png" alt="Fachada de Il Forno Nero de noche" loading="lazy" /><p class="lead">Estamos en Chueca, a unos minutos de las estaciones de Chueca y Gran Vía.</p></div></div></section>
  </main>
  <footer><div class="shell">Il Forno Nero · Calle de la Reina, 14 · Madrid · <a href="/noticias">Noticias</a></div></footer>
  <script>
    const cms = import.meta.env.PUBLIC_CMS_URL || 'http://localhost:3001'
    const catalog = document.querySelector('[data-menu-catalog]')
    const cartList = document.querySelector('[data-cart]')
    const total = document.querySelector('[data-total]')
    const cart = new Map()
    const euro = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' })
    const escapeHTML = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char])
    const renderCart = () => { const items = [...cart.values()]; cartList.innerHTML = items.length ? items.map((item) => `<li>${escapeHTML(item.name)} × ${item.quantity} <button type="button" data-remove="${escapeHTML(item.slug)}" aria-label="Quitar ${escapeHTML(item.name)}">×</button>${item.customizations.length ? `<small>${item.customizations.map(escapeHTML).join(', ')}</small>` : ''}</li>`).join('') : '<li>Aún no has añadido productos.</li>'; total.textContent = euro.format(items.reduce((sum, item) => sum + item.price * item.quantity, 0)) }
    const addItem = (button) => { const slug = button.dataset.slug; const customizations = document.querySelector(`[data-customizations="${CSS.escape(slug)}"]`)?.value.split(',').map((value) => value.trim()).filter(Boolean) || []; const current = cart.get(slug); cart.set(slug, current ? { ...current, quantity: current.quantity + 1, customizations } : { slug, name: button.dataset.name, price: Number(button.dataset.price), quantity: 1, customizations }); renderCart() }
    document.addEventListener('click', (event) => { const button = event.target.closest('.add-item'); if (button) addItem(button); const remove = event.target.closest('[data-remove]'); if (remove) { cart.delete(remove.dataset.remove); renderCart() } })
    const visibleNow = (campaign) => { const now = new Date(); const day = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'][now.getDay()]; const hhmm = now.toTimeString().slice(0, 5); return campaign.active && (!campaign.startsAt || new Date(campaign.startsAt) <= now) && (!campaign.endsAt || new Date(campaign.endsAt) >= now) && (!campaign.weekdays?.length || campaign.weekdays.includes(day)) && (!campaign.startsAtTime || campaign.startsAtTime <= hhmm) && (!campaign.endsAtTime || campaign.endsAtTime >= hhmm) }
    const showCampaigns = async () => { try { const response = await fetch(`${cms}/api/campaigns?limit=20&where[active][equals]=true`); const { docs = [] } = await response.json(); const campaigns = docs.filter(visibleNow); const show = (index = 0) => { const campaign = campaigns[index]; if (!campaign) return; const dialog = document.createElement('dialog'); dialog.innerHTML = `<button class="close" type="button" aria-label="Cerrar">×</button><p class="eyebrow">Oferta flash</p>${campaign.imageUrl ? `<img src="${escapeHTML(campaign.imageUrl)}" alt="" />` : ''}<h2>${escapeHTML(campaign.title)}</h2><p>${escapeHTML(campaign.body || '')}</p>${campaign.ctaUrl ? `<a class="button" href="${escapeHTML(campaign.ctaUrl)}">${escapeHTML(campaign.ctaLabel || 'Ver más')}</a>` : ''}`; document.body.append(dialog); dialog.showModal(); dialog.querySelector('.close').addEventListener('click', () => { dialog.close(); dialog.remove(); show(index + 1) }, { once: true }) }; show() } catch { /* The public site remains usable if the CMS is temporarily unavailable. */ } }
    const loadReservationSlots = async () => { try { const response = await fetch(`${cms}/api/public/reservation-options`); const { slots = [], closures = [] } = await response.json(); const select = document.querySelector('[data-reservation-slots]'); const date = document.querySelector('[name="date"]'); if (!slots.length || !select || !date) return; select.innerHTML = `<option value="">Selecciona una hora</option>${slots.map((slot) => `<option value="${escapeHTML(slot)}">${escapeHTML(slot)}</option>`).join('')}`; date.addEventListener('change', () => { const isClosed = closures.includes(date.value); select.disabled = isClosed; if (isClosed) select.value = ''; date.setCustomValidity(isClosed ? 'El restaurante está cerrado en esa fecha.' : '') }) } catch { /* Submission is still server-validated if public settings cannot load. */ } }
    const replaceCatalog = async () => { try { const response = await fetch(`${cms}/api/products?limit=100&depth=1&where[available][equals]=true`); const { docs = [] } = await response.json(); if (docs.length < 23) return; const categories = new Map(); docs.forEach((product) => { const category = product.category?.name || 'Carta'; if (!categories.has(category)) categories.set(category, []); categories.get(category).push(product) }); catalog.innerHTML = [...categories].map(([name, products]) => `<div class="category"><h3>${escapeHTML(name)}</h3>${products.map((product) => `<article class="item"><div class="itemhead"><span>${escapeHTML(product.name)}</span><span>${euro.format(product.price)}</span></div><p>${escapeHTML(product.description || '')}</p><label class="customize">Personaliza<input data-customizations="${escapeHTML(product.slug)}" maxlength="180" placeholder="Sin cebolla, punto de horneado…" /></label><button class="button add-item" type="button" data-slug="${escapeHTML(product.slug)}" data-name="${escapeHTML(product.name)}" data-price="${product.price}">Añadir al pedido</button></article>`).join('')}</div>`).join('') } catch { /* Static fallback is intentionally retained for public availability. */ } }
    showCampaigns(); replaceCatalog(); loadReservationSlots(); renderCart()
    document.querySelectorAll('form[data-operation]').forEach((form) => form.addEventListener('submit', async (event) => { event.preventDefault(); const message = form.querySelector('[data-message]'); const data = Object.fromEntries(new FormData(form)); const isOrder = form.dataset.operation === 'order'; if (isOrder && !cart.size) { message.textContent = 'Añade al menos un producto a tu pedido.'; return } if (isOrder) data.items = [...cart.values()].map(({ slug, quantity, customizations }) => ({ productSlug: slug, quantity, customizations })); try { const endpoint = isOrder ? 'orders' : 'reservations'; const response = await fetch(`${cms}/api/public/${endpoint}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }); const result = await response.json(); if (!response.ok) throw new Error(result.message); message.textContent = isOrder ? 'Pedido registrado como pagado (simulación). Te esperamos para recogerlo.' : 'Solicitud registrada. El equipo se pondrá en contacto contigo.'; form.reset(); if (isOrder) { cart.clear(); renderCart() } } catch (error) { message.textContent = error.message || 'No se ha podido registrar la solicitud. Llámanos para atenderte.' } }))
  </script>
</Base>
