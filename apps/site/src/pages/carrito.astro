---
import Base from '../layouts/Base.astro'
import SiteHeader from '../components/SiteHeader.astro'
---
<Base title="Carrito · Il Forno Nero">
  <SiteHeader />
  <main class="menu"><section><div class="shell split"><div><p class="eyebrow">Tu pedido</p><h1>Revisa antes de recoger.</h1><p class="lead">Ajusta cantidades, elimina lo que no quieras y confirma cuándo vienes. No se realiza ningún cobro real.</p><div class="cart cart-page" data-cart aria-live="polite"></div><a class="button alt" href="/carta">Seguir eligiendo</a></div><form class="panel" data-order-form><p class="eyebrow">Confirmar pedido</p><p class="note">Pago simulado · Recogida en local</p><label>Nombre<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Teléfono<input name="telephone" autocomplete="tel" required /></label><label>Recogida<select name="pickupMinutes" required><option value="30">En 30 minutos</option><option value="45">En 45 minutos</option></select></label><button class="button" type="submit" data-checkout>Confirmar pedido simulado</button><p class="note" data-message aria-live="polite"></p></form></div></section></main>
  <footer><div class="shell"><a href="/">Volver a Il Forno Nero</a></div></footer>
  <script>
    import { cartItems, cartTotal, changeQuantity, checkoutKey, clearCart, formatEuro, removeFromCart, setAvailability } from '../scripts/cart'
    const cms = import.meta.env.PUBLIC_CMS_URL || 'http://localhost:3001'
    const escapeHTML = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char])
    const render = () => { const target = document.querySelector('[data-cart]'); const items = cartItems(); document.querySelectorAll('[data-cart-count]').forEach((node) => node.textContent = String(items.reduce((sum, item) => sum + item.quantity, 0))); target.innerHTML = items.length ? `<ul>${items.map((item) => `<li class="${item.available ? '' : 'unavailable'}"><div><strong>${escapeHTML(item.name)}</strong>${item.note ? `<small>${escapeHTML(item.note)}</small>` : ''}${item.available ? '' : '<small>No disponible: retíralo para confirmar.</small>'}</div><div class="cart-actions"><button type="button" data-quantity="${escapeHTML(item.slug)}" data-delta="-1" aria-label="Reducir ${escapeHTML(item.name)}">−</button><span>${item.quantity}</span><button type="button" data-quantity="${escapeHTML(item.slug)}" data-delta="1" aria-label="Aumentar ${escapeHTML(item.name)}">+</button><button type="button" data-remove="${escapeHTML(item.slug)}" aria-label="Quitar ${escapeHTML(item.name)}">×</button></div><strong>${formatEuro(item.price * item.quantity)}</strong></li>`).join('')}</ul><p class="cart-total">Total: <strong>${formatEuro(cartTotal())}</strong></p>` : '<p>Aún no has añadido productos. <a href="/carta">Ir a la carta</a></p>'; const blocked = !items.length || items.some((item) => !item.available); document.querySelector('[data-checkout]').disabled = blocked }
    const syncAvailability = async () => { try { const { docs = [] } = await (await fetch(`${cms}/api/products?limit=100`)).json(); setAvailability(new Set(docs.filter((product) => product.available).map((product) => product.slug))); render() } catch { render() } }
    const setup = () => { render(); syncAvailability(); const target = document.querySelector('[data-cart]'); if (!target.dataset.bound) { target.dataset.bound = 'true'; target.addEventListener('click', (event) => { const remove = event.target.closest('[data-remove]'); const quantity = event.target.closest('[data-quantity]'); if (remove) removeFromCart(remove.dataset.remove); if (quantity) changeQuantity(quantity.dataset.quantity, cartItems().find((item) => item.slug === quantity.dataset.quantity).quantity + Number(quantity.dataset.delta)); render() }) } const form = document.querySelector('[data-order-form]'); if (!form.dataset.bound) { form.dataset.bound = 'true'; form.addEventListener('submit', async (event) => { event.preventDefault(); const button = form.querySelector('[data-checkout]'); const message = form.querySelector('[data-message]'); const items = cartItems(); if (!items.length || items.some((item) => !item.available)) { message.textContent = 'Revisa los artículos no disponibles antes de confirmar.'; return } button.disabled = true; try { const data = Object.fromEntries(new FormData(form)); data.checkoutKey = checkoutKey(); data.items = items.map(({ slug, quantity, note }) => ({ productSlug: slug, quantity, customizations: note ? [note] : [] })); const response = await fetch(`${cms}/api/public/orders`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }); const result = await response.json(); if (!response.ok) throw new Error(result.message); clearCart(); form.reset(); document.querySelector('[data-cart]').innerHTML = `<p class="success">Pedido recibido. Te esperamos en ${data.pickupMinutes} minutos. El pago es una simulación y no se ha realizado ningún cobro.</p>`; message.textContent = '' } catch (error) { message.textContent = error.message || 'No se ha podido registrar el pedido. Inténtalo de nuevo.'; button.disabled = false; await syncAvailability() } }) } }
    document.addEventListener('astro:page-load', setup)
  </script>
</Base>
