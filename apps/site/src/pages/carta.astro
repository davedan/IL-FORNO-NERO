---
import Base from '../layouts/Base.astro'
import { fallbackMenu } from '../lib/menu'

const categoryImages: Record<string, string> = {
  Entrantes: 'https://images.hostinger.com/1c3e9407-d0ba-4059-a58c-4bb92661df5b.png',
  'Pizzas Clásicas': 'https://images.hostinger.com/161cae1b-fb49-46dc-9743-508f76b01f69.png',
  'Pizzas Especiales': 'https://images.hostinger.com/7531b623-2fe3-42e0-a495-1d596c21232b.png',
  Postres: 'https://images.hostinger.com/5267ed01-5467-474b-b569-159afc6742c6.png',
  Bebidas: 'https://images.hostinger.com/b2a4aa15-82c8-42b2-ae66-6d9a90a61abf.png',
}
---
<Base title="Carta · Il Forno Nero">
  <header class="shell nav"><a class="brand" href="/">Il Forno Nero</a><nav class="navlinks"><a href="/">Inicio</a><a href="/carta">Carta</a><a href="/carrito">Carrito <span data-cart-count>0</span></a><a href="/#reservas">Reservas</a></nav></header>
  <main class="menu"><section><div class="shell"><p class="eyebrow">La carta</p><h1>Producto italiano, fuego vivo.</h1><p class="lead">Elige tus platos y personalízalos con una observación para el equipo. Los precios y la disponibilidad se confirman al pedir.</p><p class="cart-link"><a class="button alt" href="/carrito">Ver carrito · <span data-cart-count>0</span> artículos · <span data-cart-total>0,00 €</span></a></p><div class="menu-groups" data-menu-catalog>{fallbackMenu.map((category) => <section class="menu-group"><img src={categoryImages[category.name]} alt="" loading="lazy" /><div class="menu-group-content"><h2>{category.name}</h2>{category.note && <p class="menu-group-note">{category.note}</p>}{category.items.map((item) => <article class="item"><img class="item-art" src={categoryImages[category.name]} alt="" loading="lazy" /><div class="itemhead"><span>{item.name}{item.vegetarian && ' · V'}</span><span>{item.price.toFixed(2)} €</span></div><p>{item.description}</p>{item.available ? <><label class="customize">Personaliza<input data-customizations={item.slug} maxlength="180" placeholder="Sin cebolla, punto de horneado…" /></label><button class="button add-item" type="button" data-slug={item.slug} data-name={item.name} data-price={item.price}>Añadir al pedido</button></> : <span class="note">No disponible</span>}</article>)}</div></section>)}</div></div></section></main>
  <footer><div class="shell"><a href="/">Volver a Il Forno Nero</a></div></footer>
  <script>
    import { addToCart, cartItems, cartTotal, formatEuro } from '../scripts/cart'
    const cms = import.meta.env.PUBLIC_CMS_URL || 'http://localhost:3001'
    const categoryImages = { Entrantes: 'https://images.hostinger.com/1c3e9407-d0ba-4059-a58c-4bb92661df5b.png', 'Pizzas Clásicas': 'https://images.hostinger.com/161cae1b-fb49-46dc-9743-508f76b01f69.png', 'Pizzas Especiales': 'https://images.hostinger.com/7531b623-2fe3-42e0-a495-1d596c21232b.png', Postres: 'https://images.hostinger.com/5267ed01-5467-474b-b569-159afc6742c6.png', Bebidas: 'https://images.hostinger.com/b2a4aa15-82c8-42b2-ae66-6d9a90a61abf.png' }
    const escapeHTML = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[char])
    const renderSummary = () => { document.querySelectorAll('[data-cart-count]').forEach((node) => node.textContent = String(cartItems().reduce((sum, item) => sum + item.quantity, 0))); document.querySelectorAll('[data-cart-total]').forEach((node) => node.textContent = formatEuro(cartTotal())) }
    const bindAdd = () => { const target = document.querySelector('[data-menu-catalog]'); if (!target || target.dataset.bound) return; target.dataset.bound = 'true'; target.addEventListener('click', (event) => { const button = event.target.closest('.add-item'); if (!button) return; const note = document.querySelector(`[data-customizations="${CSS.escape(button.dataset.slug)}"]`)?.value.trim() || ''; addToCart({ slug: button.dataset.slug, name: button.dataset.name, price: Number(button.dataset.price), note }); renderSummary() }) }
    const replaceCatalog = async () => { try { const response = await fetch(`${cms}/api/products?limit=100&depth=1`); const { docs = [] } = await response.json(); if (!docs.length) return; const categories = new Map(); docs.forEach((product) => { const category = product.category?.name || 'Carta'; if (!categories.has(category)) categories.set(category, []); categories.get(category).push(product) }); const target = document.querySelector('[data-menu-catalog]'); target.innerHTML = [...categories].map(([name, products]) => { const image = products.find((product) => product.imageUrl)?.imageUrl || categoryImages[name] || categoryImages['Pizzas Clásicas']; return `<section class="menu-group"><img src="${escapeHTML(image)}" alt="" loading="lazy" /><div class="menu-group-content"><h2>${escapeHTML(name)}</h2>${products.map((product) => { const productImage = product.imageUrl || image; return `<article class="item"><img class="item-art" src="${escapeHTML(productImage)}" alt="" loading="lazy" /><div class="itemhead"><span>${escapeHTML(product.name)}</span><span>${formatEuro(product.price)}</span></div><p>${escapeHTML(product.description || '')}</p>${product.available ? `<label class="customize">Personaliza<input data-customizations="${escapeHTML(product.slug)}" maxlength="180" placeholder="Sin cebolla, punto de horneado…" /></label><button class="button add-item" type="button" data-slug="${escapeHTML(product.slug)}" data-name="${escapeHTML(product.name)}" data-price="${product.price}">Añadir al pedido</button>` : '<span class="note">No disponible</span>'}</article>` }).join('')}</div></section>` }).join('') } catch {} }
    document.addEventListener('astro:page-load', () => { renderSummary(); bindAdd(); replaceCatalog() })
  </script>
</Base>
